const Utils = {
  /** 过滤掉流量/到期提示等非代理节点 */
  filterProxies(proxies, excludePattern) {
    return proxies.filter((p) => !excludePattern.test(p.name));
  },

  /** 按第一个匹配到的地区分类节点，未匹配的归入"🗃️ 其它" */
  groupProxiesByRegion(proxies, regions) {
    const matchableRegions = regions.filter((r) => r.regex);
    const groups = {};

    for (const proxy of proxies) {
      const region = matchableRegions.find((r) => r.regex.test(proxy.name));
      const bucket = region ? region.name : "🗃️ 其它";
      (groups[bucket] ??= []).push(proxy.name);
    }

    return groups;
  },
};

