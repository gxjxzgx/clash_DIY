// ============================================================================
// 主入口函数
// ============================================================================

function main(params) {
  params = params || {};
  const proxies = params.proxies || [];

  if (proxies.length === 0) {
    console.warn("未找到任何代理节点，部分分组可能为空。");
  }

  // 过滤掉流量/到期时间/订阅群等非代理信息条目
  const nonProxyPattern = /流量|到期|剩余|官网|网址|套餐|群|频道|订阅|重置/i;
  const cleanProxies = Utils.filterProxies(proxies, nonProxyPattern);
  const proxyNames = cleanProxies.map((p) => p.name);
  // "全部节点"分组专用：不经过 nonProxyPattern 过滤的原始节点名单
  const allProxyNames = proxies.map((p) => p.name);

  const groupedProxies = Utils.groupProxiesByRegion(cleanProxies, CONFIG.regions);
  const fallbackProxies = FALLBACK_NODE_PATTERN
    ? proxyNames.filter((name) => FALLBACK_NODE_PATTERN.test(name))
    : [];

  const output = { proxies: [...proxies, ...LANDING_INLINE_PROXIES, ...LANDING_DIRECT_PROXIES] };
  Object.assign(output, Builders.buildBasicOptions());

  output.dns = Builders.buildDns();
  output.sniffer = Builders.buildSniffer();
  output.tun = Builders.buildTun();
  output["proxy-groups"] = Builders.buildProxyGroups(proxyNames, groupedProxies, fallbackProxies, allProxyNames);
  output.rules = Builders.buildRules();
  output["rule-providers"] = Builders.buildRuleProviders();

  return output;
}

